{
  "1": {"class_type": "UNETLoader", "_meta": {"title": "Modelo Wan 2.2 TI2V 5B"},
        "inputs": {"unet_name": "wan2.2_ti2v_5B_fp16.safetensors", "weight_dtype": "default"}},
  "2": {"class_type": "CLIPLoader", "_meta": {"title": "Codificador de texto UMT5"},
        "inputs": {"clip_name": "umt5_xxl_fp8_e4m3fn_scaled.safetensors", "type": "wan"}},
  "3": {"class_type": "VAELoader", "_meta": {"title": "VAE Wan 2.2"},
        "inputs": {"vae_name": "wan2.2_vae.safetensors"}},
  "4": {"class_type": "ModelSamplingSD3", "_meta": {"title": "Shift de muestreo"},
        "inputs": {"model": ["1", 0], "shift": 8.0}},
  "5": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt positivo (inglés: sujeto, movimiento, cámara, estilo)"},
        "inputs": {"clip": ["2", 0], "text": "a red fox running through a snowy forest, camera tracking shot, cinematic lighting"}},
  "6": {"class_type": "CLIPTextEncode", "_meta": {"title": "Prompt negativo"},
        "inputs": {"clip": ["2", 0], "text": "blurry, low quality, distorted, static, watermark, text, jpeg artifacts, deformed"}},
  "7": {"class_type": "Wan22ImageToVideoLatent", "_meta": {"title": "Tamaño y duración: nativo 1280x704 o 704x1280 (menos degrada mucho); length = frames 4n+1 a 24 fps"},
        "inputs": {"vae": ["3", 0], "width": 1280, "height": 704, "length": 49, "batch_size": 1}},
  "8": {"class_type": "KSampler", "_meta": {"title": "Sampler (seed, steps, cfg)"},
        "inputs": {"model": ["4", 0], "positive": ["5", 0], "negative": ["6", 0], "latent_image": ["7", 0],
                   "seed": 42, "steps": 20, "cfg": 5.0, "sampler_name": "uni_pc", "scheduler": "simple", "denoise": 1.0}},
  "9": {"class_type": "VAEDecode", "_meta": {"title": "Decodificar frames"},
        "inputs": {"samples": ["8", 0], "vae": ["3", 0]}},
  "10": {"class_type": "CreateVideo", "_meta": {"title": "Vídeo (fps)"},
         "inputs": {"images": ["9", 0], "fps": 24.0}},
  "11": {"class_type": "SaveVideo", "_meta": {"title": "Guardar MP4"},
         "inputs": {"video": ["10", 0], "filename_prefix": "video/wan", "format": "auto", "format.codec": "auto"}}
}
